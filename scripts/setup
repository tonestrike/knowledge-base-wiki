#!/usr/bin/env bash
# scripts/setup — first-run developer setup for tenex.
#
# Idempotent. Re-runs detect existing state and skip work that's already done.
#
# Steps:
#   1. Verify bun >= 1.3.0
#   2. Verify Node.js >= 22 is reachable (wrangler dev needs real Node — under
#      bun, wrangler's ProxyWorker IPC fails silently and HTTP requests hang).
#      Auto-sources ~/.nvm/nvm.sh if present so lazy-loaded nvm setups work.
#   3. bun install (also runs `rulesync generate` via postinstall)
#   4. If apps/api/.dev.vars is missing, seed it from .dev.vars.example so the
#      Worker has the env vars it needs. The user fills in their own values.
#   5. Run `bun run check`.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
API_DIR="$REPO_ROOT/apps/api"
DEV_VARS="$API_DIR/.dev.vars"
DEV_VARS_EXAMPLE="$API_DIR/.dev.vars.example"

step() { printf '\n[step] %s\n' "$*"; }
ok()   { printf '[ok]   %s\n' "$*"; }
skip() { printf '[skip] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*" >&2; }
fail() { printf '[fail] %s\n' "$*" >&2; exit 1; }

# Returns 0 if $1 (current) is >= $2 (minimum), per `sort -V`.
version_at_least() {
  [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" == "$2" ]]
}

cd "$REPO_ROOT"

# 1) bun version
step "Verify bun >= 1.3.0"
command -v bun >/dev/null || fail "bun not found on PATH. Install: curl -fsSL https://bun.sh/install | bash"
BUN_VERSION="$(bun --version)"
version_at_least "$BUN_VERSION" "1.3.0" || fail "bun $BUN_VERSION is too old; need >= 1.3.0"
ok "bun $BUN_VERSION"

# 2) Node.js (wrangler dev requires real Node, not bun)
step "Verify Node.js >= 22"
if ! command -v node >/dev/null; then
  # Lazy-loaded nvm setups only expose `node` after the shell function fires.
  # Source nvm.sh once so the rest of the script and bun-spawned children
  # see the active version.
  if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    # shellcheck disable=SC1091
    set +u; . "$HOME/.nvm/nvm.sh"; set -u
    if [[ -f "$REPO_ROOT/.nvmrc" ]] && command -v nvm >/dev/null; then
      nvm use >/dev/null 2>&1 || true
    fi
  fi
fi
command -v node >/dev/null || fail "node not found on PATH. Install Node.js >= 22 (e.g. \`nvm install 22 && nvm use 22\`)."
NODE_VERSION="$(node --version | sed 's/^v//')"
version_at_least "$NODE_VERSION" "22.0.0" || fail "node $NODE_VERSION is too old; need >= 22 (wrangler ProxyWorker IPC breaks under bun-as-node)"
ok "node $NODE_VERSION"

# 3) deps
step "bun install"
bun install
ok "deps installed"

# 4) Seed apps/api/.dev.vars from the committed example if missing.
step "Ensure apps/api/.dev.vars exists"
if [[ -f "$DEV_VARS" ]]; then
  skip ".dev.vars already present at $DEV_VARS"
else
  [[ -f "$DEV_VARS_EXAMPLE" ]] || fail "missing $DEV_VARS_EXAMPLE — repo is in an unexpected state"
  cp "$DEV_VARS_EXAMPLE" "$DEV_VARS"
  ok "wrote $DEV_VARS (copied from .dev.vars.example)"
  warn "open $DEV_VARS and fill in real values before running \`bun --filter @app/api dev\`"
fi

# 5) full check
step "Run bun run check"
bun run check
ok "check passed"

printf '\n[done] First-run setup complete.\n'
printf '       Next: fill in apps/api/.dev.vars, then run \`bun run dev\`.\n'
