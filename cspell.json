{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules/**",
    "dist/**",
    ".turbo/**",
    ".wrangler/**",
    ".next/**",
    "*.tsbuildinfo",
    "bun.lock",
    ".claude/plugins/cache/**",
    "playwright-report/**",
    "test-results/**",
    "blob-report/**",
    "CLAUDE.md",
    "AGENTS.md",
    ".mcp.json",
    ".claude/rules/**",
    ".claude/skills/**",
    ".codex/rules/**",
    ".codex/skills/**",
    ".codex/config.toml",
    ".agents/rules/**",
    ".agents/skills/**"
  ],
  "dictionaryDefinitions": [
    {
      "name": "tenex-shared",
      "path": "./docs/glossary.txt",
      "addWords": false
    },
    {
      "name": "core-glossary",
      "path": "./packages/domains/core/.cspell/glossary.txt",
      "addWords": false
    },
    {
      "name": "ingestion-glossary",
      "path": "./packages/domains/ingestion/.cspell/glossary.txt",
      "addWords": false
    },
    {
      "name": "wiki-glossary",
      "path": "./packages/domains/wiki/.cspell/glossary.txt",
      "addWords": false
    },
    {
      "name": "chat-glossary",
      "path": "./packages/domains/chat/.cspell/glossary.txt",
      "addWords": false
    },
    {
      "name": "verification-glossary",
      "path": "./packages/domains/verification/.cspell/glossary.txt",
      "addWords": false
    }
  ],
  "dictionaries": ["tenex-shared"],
  "import": ["@cspell/dict-typescript/cspell-ext.json"],
  "overrides": [
    {
      "filename": "packages/domains/core/**",
      "dictionaries": ["tenex-shared", "core-glossary"]
    },
    {
      "filename": "packages/domains/ingestion/**",
      "dictionaries": ["tenex-shared", "ingestion-glossary"]
    },
    {
      "filename": "packages/domains/wiki/**",
      "dictionaries": ["tenex-shared", "wiki-glossary"]
    },
    {
      "filename": "packages/domains/chat/**",
      "dictionaries": ["tenex-shared", "chat-glossary"]
    },
    {
      "filename": "packages/domains/verification/**",
      "dictionaries": ["tenex-shared", "verification-glossary"]
    }
  ],
  "words": []
}
