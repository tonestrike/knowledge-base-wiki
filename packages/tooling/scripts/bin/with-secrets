#!/usr/bin/env bash
# Wrapper that authenticates Infisical with per-repo Machine Identity creds,
# then exec's the requested command with secrets injected.
#
# Required env vars (typically exported from ~/.zshrc):
#   INFISICAL_CLIENT_ID_TENEX
#   INFISICAL_CLIENT_SECRET_TENEX
#
# Pre-set INFISICAL_TOKEN to skip the login step (CI uses this).
#
# Usage in package.json scripts:
#   "dev": "with-secrets --env=dev --path=/apps/api --recursive -- wrangler dev"
#
# Bun adds node_modules/.bin to PATH, so the bin name resolves directly.

set -euo pipefail

if [[ -z "${INFISICAL_TOKEN:-}" ]]; then
  : "${INFISICAL_CLIENT_ID_TENEX:?INFISICAL_CLIENT_ID_TENEX must be set in your shell (export it in ~/.zshrc)}"
  : "${INFISICAL_CLIENT_SECRET_TENEX:?INFISICAL_CLIENT_SECRET_TENEX must be set in your shell (export it in ~/.zshrc)}"

  INFISICAL_TOKEN=$(bunx infisical login \
    --method=universal-auth \
    --client-id="$INFISICAL_CLIENT_ID_TENEX" \
    --client-secret="$INFISICAL_CLIENT_SECRET_TENEX" \
    --plain --silent)
  export INFISICAL_TOKEN
fi

# `infisical run` with a Machine Identity token needs an explicit project ID;
# its cwd-based `.infisical.json` auto-detect doesn't fire when invoked from a
# subdirectory like apps/api/ (where `bun --filter` lands). Pull workspaceId
# from .infisical.json at the repo root if available.
project_args=()
if repo_root=$(git rev-parse --show-toplevel 2>/dev/null) && [[ -f "$repo_root/.infisical.json" ]]; then
  project_id=$(grep -oE '"workspaceId"[[:space:]]*:[[:space:]]*"[^"]+"' "$repo_root/.infisical.json" \
    | sed -E 's/.*"([^"]+)"$/\1/')
  [[ -n "$project_id" ]] && project_args=(--projectId="$project_id")
fi

exec bunx infisical run --token="$INFISICAL_TOKEN" "${project_args[@]}" "$@"
