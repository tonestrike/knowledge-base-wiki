{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "./scripts/dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "bun --filter @app/web run build && wrangler deploy --env=prod",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "secrets:put": "wrangler secret bulk --env=prod .dev.vars",
    "clean": "rm -rf dist .wrangler .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@orpc/server": "^1.14.2",
    "ai": "^6.0.177",
    "@package/contracts": "workspace:*",
    "@domain/core": "workspace:*",
    "@domain/ingestion": "workspace:*",
    "@domain/wiki": "workspace:*",
    "@domain/chat": "workspace:*",
    "@domain/verification": "workspace:*",
    "@package/shared-kernel": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@tooling/tsconfig": "workspace:*",
    "@types/bun": "^1.3.13",
    "typescript": "^5.7.2",
    "wrangler": "^4"
  }
}
