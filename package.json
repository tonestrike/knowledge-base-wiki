{
  "name": "tenex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": ["apps/*", "packages/*", "packages/domains/*", "packages/tooling/*"],
  "scripts": {
    "postinstall": "bunx --bun rulesync generate",
    "setup": "./scripts/setup",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "check": "bun run lint && bun run spell && bun run typecheck && bun run test",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "spell": "cspell '**/*.{ts,tsx,md}' --no-progress",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "rulesync": "bunx --bun rulesync generate",
    "rulesync:watch": "bunx --bun rulesync watch",
    "rulesync:install": "bunx --bun rulesync install",
    "rulesync:install:frozen": "bunx --bun rulesync install --frozen"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@infisical/cli": "^0.43.84",
    "cspell": "^8.17.1",
    "rulesync": "^8.15.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
